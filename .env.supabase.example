# Supabase demo database credentials
# Copy this to .env.supabase (gitignored) and fill in the password.
#
# How to find your DB password:
#   Supabase Dashboard → your project → Settings → Database
#   → Under "Connection string" copy the password, OR
#   → Click "Reset database password" to set a new one
#
# Project ref: luiszfcgmpznsosddsaf
# Dashboard:   https://supabase.com/dashboard/project/luiszfcgmpznsosddsaf

SUPABASE_REF=luiszfcgmpznsosddsaf
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# Admin credentials for the demo API
ADMIN_EMAIL=admin@wheelcheck.my
ADMIN_PASSWORD=your_admin_password_here

# Local DB (defaults, change if different)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=wheelcheck
LOCAL_DB_NAME=wheelcheck
LOCAL_DB_PASSWORD=wheelcheck_dev

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/wheelcheck
DATABASE_USERNAME=wheelcheck
DATABASE_PASSWORD=wheelcheck_password_change_me

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-minimum-32-characters-required

# Upload Configuration
UPLOAD_DIRECTORY=uploads

# Server Configuration
SERVER_PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Gemini AI Enrichment (free tier: 1,500 req/day, 15 req/min)
# Get your key at: https://aistudio.google.com → Get API key → Create API key
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
# Daily cap — set below Gemini's free tier limit of 1,500 to stay safe
GEMINI_DAILY_CAP=1400
